# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# astro
/dist/
/.astro/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Claude Code agent worktrees
/.claude/worktrees/

# Wrangler local dev state
/.wrangler/

# Stacki Mac app: its per-machine publish settings (it may point at a host this site doesn't use)
/.stacki/

# Stacki (and anything else) running `npm install` writes this; the lockfile here is pnpm-lock.yaml
/package-lock.json
