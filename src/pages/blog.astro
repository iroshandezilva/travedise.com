---
import CloseBand from "@/components/CloseBand.astro";
import NoteCard from "@/components/NoteCard.astro";
import PageHead from "@/components/PageHead.astro";
import Base from "@/layouts/Base.astro";
import { noteCategories } from "@/data/blog";
import { NOTES } from "@/data/site";
---

<Base
  title="Travel notes"
  description="Short, practical notes on Sri Lanka from the people who plan the trips: which coast in which month, what to book early and what to skip."
  canonical="/blog"
  section="notes"
>
  <PageHead title="Travel <em>notes.</em>" lede="Short, practical notes from the people who plan the trips: what to book early, what to skip, and which coast in which month." />

  <section class="wrap" style="padding-bottom:clamp(88px,11vw,160px)" aria-label="All travel notes">
    <div data-filter-root="#notesGrid" data-word="note">
      <div class="filters">
        <div class="f-row" role="group" aria-label="Topic">
          <b aria-hidden="true">Topic</b>
          <button type="button" class="chip" data-f="cat" data-v="all" aria-pressed="true">All</button>
          {noteCategories.map((c) => <button type="button" class="chip" data-f="cat" data-v={c} aria-pressed="false">{c}</button>)}
        </div>
        <div class="f-foot"><span data-count aria-live="polite">{NOTES.length} notes</span></div>
      </div>
      <div class="notes-grid" id="notesGrid">
        {NOTES.map((n, i) => <NoteCard note={n} eager={i === 0} />)}
      </div>
    </div>
  </section>

  <CloseBand photo="teaMist" title="Questions <em>we haven’t answered?</em>" cta="Ask us" />
</Base>
