---
import Ar from "@/components/Ar.astro";
import Band from "@/components/Band.astro";
import CloseBand from "@/components/CloseBand.astro";
import Frame from "@/components/Frame.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import type { PhotoKey } from "@/data/photos";
import { CONTACT, PRINCIPLES, PROOF } from "@/data/site";

const [galle, bundeena] = CONTACT.offices;
const [auPhone, lkPhone] = CONTACT.phones;
const offices: { title: string; photo: PhotoKey | null; address: string; phone: { number: string; tel: string } }[] = [
  { title: "Galle, Sri Lanka", photo: "galleStreet", address: galle!.address, phone: lkPhone! },
  { title: "Bundeena, Australia", photo: "bundeena", address: bundeena!.address, phone: auPhone! },
];
---

<Base
  title="About us"
  description="A small team in Galle and Bundeena planning private trips to Sri Lanka and the Maldives: how we plan, the rules we hold to, and where to find us."
  canonical="/about"
  section="about"
>
  <PageHead title="A small team <em>on two coasts.</em>" lede="We plan trips to Sri Lanka and the Maldives from a desk in Galle and one in Bundeena, New South Wales. The person you first write to plans your trip." />

  <section class="wrap" style="padding-bottom:clamp(88px,11vw,160px)">
    <div class="split">
      <div class="a"><Frame photo="traveller" pos="50% 40%" eager sizes="(max-width: 860px) 100vw, 50vw" /></div>
      <div class="b">
        <p class="statement" style="font-size:var(--fs-h3)">We would rather send you to four places properly <em>than nine from a car window.</em></p>
        <p class="small">Every route is written by someone who has driven it, and one of us has slept in every room we book. Where that is not true yet, we say so.</p>
        <a class="btn ink" href="/plan-your-trip">Talk to our team <Ar /></a>
      </div>
    </div>
  </section>

  <Band photo="teaMist" title="How we <em>plan.</em>" text="Four rules we hold to, even when a longer itinerary would sell better." />

  <section class="sect wrap">
    <div class="princ">
      {PRINCIPLES.map(([t, b]) => <div><h3 class="h3">{t}</h3><p>{b}</p></div>)}
    </div>
  </section>

  <section class="sect wrap top0">
    <h2 class="visually-hidden">What you can count on</h2>
    <ul class="proof">
      {PROOF.map(([t, d]) => <li><h3 class="h4">{t}</h3><p>{d}</p></li>)}
    </ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Two <em>offices.</em>"><p>Write to either. The same team answers, and the person who replies plans your trip.</p></SecHead>
    <div class="offices">
      {
        offices.map((o) => (
          <div>
            <Frame photo={o.photo} empty="Photo of the office to come" sizes="(max-width: 760px) 100vw, 50vw" />
            <h3 class="h3">{o.title}</h3>
            <p class="small">
              {o.address}
              <br />
              <a href={`tel:${o.phone.tel}`}>{o.phone.number}</a>
              <br />
              <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <CloseBand photo="galleAerial" title="Talk to <em>the team.</em>" cta="Plan your trip" />
</Base>
