---
import Offices from "@/components/v2/about/offices.astro";
import Opening from "@/components/v2/about/opening.astro";
import Principles from "@/components/v2/about/principles.astro";
import Reviews from "@/components/v2/about/reviews.astro";
import Team from "@/components/v2/about/team.astro";
import FooterWide from "@/components/v2/footer-wide.astro";
import HeroScrim from "@/components/v2/hero-scrim.astro";
import ProofStrip from "@/components/v2/home/proof-strip.astro";
import ReadyBand from "@/components/v2/home/ready-band.astro";
import SiteNav from "@/components/v2/site-nav.astro";
import { aboutHero, proofPoints, showTeam } from "@/data/v2/about";
import Base from "@/layouts/base.astro";

const TITLE = "About us — Travedise";

/**
 * The About page, from the "About The team" design: why Travedise exists, who you will
 * deal with, how the team thinks, what travellers said, and where the two offices are.
 * Sections waiting on material from the team (portraits, reviews) stay out until it
 * arrives, and the team section stays off while `showTeam` is false — see
 * `src/data/v2/about.ts`.
 */
---

<Base title={TITLE} description={aboutHero.body} canonical="/about" image={aboutHero.image} ogType="website">
  <div class="v2 flex flex-col overflow-clip bg-white">
    <header class="relative h-[520px] w-full shrink-0 overflow-clip gutter-v2 max-md:h-[560px] max-md:px-0">
      <img
        src={aboutHero.image}
        alt={aboutHero.alt}
        class="absolute inset-0 block size-full object-cover object-[50%_58%]"
      />
      <HeroScrim desktop="linear-gradient(0deg, oklab(0.182 -0.013 -0.008 / 0.9) 0%, oklab(0 0 0 / 0) 74%), linear-gradient(180deg, oklab(0.2 -0.014 -0.012 / 0.52) 0%, oklab(0 0 0 / 0) 30%)" />
      <div class="relative mx-auto h-full w-full max-w-[1280px]">
        <SiteNav />
        <div
          class="absolute inset-x-0 bottom-[58px] flex max-w-[820px] flex-col gap-[18px] max-md:right-5 max-md:bottom-8 max-md:left-5 max-md:gap-3"
        >
          <h1
            class="m-0 font-display text-[60px]/[66px] font-medium tracking-[-0.01em] text-white max-lg:text-[52px]/[58px] max-md:text-[38px]/[44px]"
          >
            {aboutHero.title}
          </h1>
          <p class="m-0 max-w-[660px] text-[19px]/[29px] text-[#e8eef1] max-md:text-[16px]/[25px]">
            {aboutHero.body}
          </p>
        </div>
      </div>
    </header>

    <main>
      <ProofStrip points={proofPoints} />
      <Opening />
      {showTeam && <Team />}
      <Principles />
      <Reviews />
      <Offices />
      <ReadyBand />
    </main>

    <FooterWide
      statement="A small island with long days in it. Plan it once, properly, and it stays with you for years."
      statementFace="body"
    />
  </div>
</Base>
