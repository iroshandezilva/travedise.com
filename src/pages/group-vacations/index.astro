---
import Ar from "@/components/Ar.astro";
import Band from "@/components/Band.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import Frame from "@/components/Frame.astro";
import PageHero from "@/components/PageHero.astro";
import SecHead from "@/components/SecHead.astro";
import Steps from "@/components/Steps.astro";
import Base from "@/layouts/Base.astro";
import { GROUP_PHOTO, groupTypes } from "@/data/content";
import { FAQ_GROUPS, GROUP_SIZES, GROUP_STEPS } from "@/data/services-pages";
---

<Base
  title="Group trips"
  description="Retreats, family reunions, milestones, pilgrimages and club tours in Sri Lanka, planned for six or more people with one planner and one plan."
  canonical="/group-vacations"
  section="services"
>
  <PageHero photo="groupLong" pos="50% 60%" title="Group trips" lede="Retreats, reunions, milestones, pilgrimages and clubs. One planner, one plan, and nobody stuck organising it.">
    <a class="btn light" href="/plan-your-trip">Plan a group trip <Ar /></a>
  </PageHero>

  <section class="sect wrap">
    <SecHead title="Who we <em>plan for.</em>" />
    <ul class="tlist">
      {
        groupTypes.map((g) => (
          <li>
            <a href={`/group-vacations/${g.slug}`}>
              <Frame photo={GROUP_PHOTO[g.slug] ?? null} widths={[200, 400]} sizes="(max-width: 860px) 120px, 200px" />
              <span><span class="t">{g.name}</span><span class="d" style="display:block">{g.summary}</span></span>
              <span class="m">{g.size}</span>
              <Ar />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Size <em>and vehicle.</em>"><p>One vehicle where we can, so the group travels together.</p></SecHead>
    <ul class="rows">{GROUP_SIZES.map((s) => <li><span class="k">{s.k}</span><span class="v">{s.v}</span><span class="w"><a href={s.href}>{s.w}</a></span></li>)}</ul>
  </section>

  <Band photo="teaAerial" title="One plan, <em>many people.</em>" text="Rooming lists, dietary needs, who shares with whom and who pays for what. We keep it in one place and send each person what they need." />

  <section class="sect wrap">
    <SecHead title="How group <em>planning works.</em>" />
    <Steps items={GROUP_STEPS} />
  </section>

  <Faq title="Group <em>questions.</em>" items={FAQ_GROUPS} />

  <CloseBand photo="templeNight" title="Bring <em>everyone.</em>" cta="Plan a group trip" />
</Base>
