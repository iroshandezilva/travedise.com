---
import Ar from "@/components/Ar.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import Frame from "@/components/Frame.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import { GROUP_PHOTO, groupTypes, type GroupType } from "@/data/content";
import { emLast, esc, lowerFirst } from "@/data/services-pages";

export function getStaticPaths() {
  return groupTypes.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}

interface Props { g: GroupType }
const { g } = Astro.props;

const enquire = `/plan-your-trip?tour=${encodeURIComponent(g.name)}`;
// The facts are, in order: how many travel, how far ahead to plan, how it is priced.
const FACT_LABELS = ["Group size", "Lead time", "Price"];
const others = groupTypes.filter((o) => o.slug !== g.slug);
---

<Base title={g.name} description={g.summary} canonical={`/group-vacations/${g.slug}`} section="services">
  <PageHead title={emLast(`${g.name}.`)} lede={g.summary}>
    <div class="acts">
      <a class="btn ink" href={enquire}>Plan this trip <Ar /></a>
      <a class="lnk" href="/group-vacations">All group trips</a>
    </div>
  </PageHead>

  <div class="wrap art-hero" style="margin-top:0">
    <Frame src={g.image.src} alt={g.image.alt} pos={g.image.position} eager />
  </div>

  <section class="wrap" style="padding-top:clamp(40px,5vw,64px)" aria-label={`${g.name} at a glance`}>
    <dl class="facts" style={`--fc:${g.facts.length}`}>
      {g.facts.map((f, i) => <div><dt>{FACT_LABELS[i] ?? f.detail}</dt><dd>{f.value}<small>{f.detail}</small></dd></div>)}
    </dl>
  </section>

  <section class="sect wrap">
    <SecHead title={emLast(g.suits.heading)}>{g.suits.body && <p>{g.suits.body}</p>}</SecHead>
    <ul class="every">{g.suits.points.map((p) => <li><span>{p}</span></li>)}</ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title={emLast(g.services.heading)}>{g.services.body && <p>{g.services.body}</p>}</SecHead>
    <div class="inc">{g.services.items.map((it) => <div><h3 class="h4">{it.title}</h3><p>{it.body}</p></div>)}</div>
  </section>

  <section class="sect wrap top0">
    <SecHead title={emLast(g.shapes.heading)}>{g.shapes.lede && <p>{g.shapes.lede}</p>}</SecHead>
    <ul class="rows">{g.shapes.items.map((s) => <li><span class="k">{s.title}</span><span class="v">{s.body}</span><span class="w">{s.length}</span></li>)}</ul>
    <div class="plan-cta"><a class="btn ink big" href={enquire}>Plan this trip <Ar /></a></div>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Other groups <em>we plan for.</em>"><a class="lnk" href="/group-vacations">All group trips <Ar /></a></SecHead>
    <ul class="tlist">
      {
        others.map((o) => (
          <li>
            <a href={`/group-vacations/${o.slug}`}>
              <Frame photo={GROUP_PHOTO[o.slug] ?? null} widths={[200, 400]} sizes="(max-width: 860px) 120px, 200px" />
              <span><span class="t">{o.name}</span><span class="d" style="display:block">{o.short}</span></span>
              <span class="m">{o.size}</span>
              <Ar />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq title={`Questions about <em>${esc(lowerFirst(g.name))}.</em>`} items={g.questions.map((q) => [q.q, q.a] as [string, string])} />

  <CloseBand photo={GROUP_PHOTO[g.slug] ?? "templeNight"} title="Bring <em>everyone.</em>" cta="Plan this trip" href={enquire} />
</Base>
