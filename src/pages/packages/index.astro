---
import Ar from "@/components/Ar.astro";
import Band from "@/components/Band.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Steps from "@/components/Steps.astro";
import TourCard from "@/components/TourCard.astro";
import Base from "@/layouts/Base.astro";
import { FAQ_GENERAL, STEPS, TOURS, TYPES } from "@/data/site";

const LENGTHS: [string, string][] = [
  ["any", "Any length"],
  ["short", "Up to 9 days"],
  ["long", "10 days or more"],
];
---

<Base
  title="Tour packages"
  description="Private tours of Sri Lanka to start from: tea country, wildlife, honeymoons and family trips. Each one can be changed to fit your dates and pace."
  canonical="/packages"
  section="tours"
>
  <PageHead title="Tour <em>packages.</em>" lede="Every tour is private, and every tour is a starting point. Pick the one that is closest, then we change it to fit." />

  <section class="wrap" style="padding-bottom:clamp(88px,11vw,160px)" aria-label="All tours">
    <div class="filters" data-filter-root="#tourList" data-word="tour">
      <div class="f-row" role="group" aria-labelledby="f-type">
        <b id="f-type">Trip type</b>
        <button type="button" class="chip" data-f="type" data-v="all" aria-pressed="true">Any</button>
        {TYPES.map((t) => <button type="button" class="chip" data-f="type" data-v={t.t} aria-pressed="false">{t.t}</button>)}
      </div>
      <div class="f-row" role="group" aria-labelledby="f-len">
        <b id="f-len">Length</b>
        {LENGTHS.map(([v, l], i) => <button type="button" class="chip" data-f="len" data-v={v} aria-pressed={i === 0 ? "true" : "false"}>{l}</button>)}
      </div>
      <div class="f-foot">
        <span data-count role="status">{TOURS.length} tours</span>
        <label>Sort
          <select data-sort>
            <option value="rec" selected>Recommended</option>
            <option value="short">Shortest first</option>
            <option value="price">Lowest price first</option>
          </select>
        </label>
      </div>
    </div>

    <div class="cardgrid" style="--n:3" id="tourList">
      {TOURS.map((t, i) => <TourCard tour={t} summary tags order={i} />)}
    </div>

    <div class="empty-state" data-empty hidden>
      <h2 class="h3">No tour matches all of that yet.</h2>
      <p class="small">Every tour can be changed, so a near match is a good start. Or tell us what you want and we will write one.</p>
      <div class="acts">
        <button type="button" class="btn line" data-clear>Clear the filters</button>
        <a class="btn ink" href="/plan-your-trip">Ask for a tailor-made trip <Ar /></a>
      </div>
    </div>
  </section>

  <Band photo="teaAerial" title="Nothing quite <em>right?</em>" text="Most of our trips are written from scratch. Tell us the dates, who is coming and what you care about.">
    <a class="btn light" href="/plan-your-trip">Ask for a tailor-made trip <Ar /></a>
  </Band>

  <section class="sect wrap">
    <SecHead title="How planning <em>works.</em>" />
    <Steps items={STEPS} />
  </section>

  <Faq title="About <em>the tours.</em>" items={FAQ_GENERAL} />

  <CloseBand photo="coconutHill" />
</Base>
