---
import FooterWide from "@/components/v2/footer-wide.astro";
import PlainHero from "@/components/v2/plain-hero.astro";
import { privacyIntro, privacySections, privacyUpdated } from "@/data/privacy";
import Base from "@/layouts/base.astro";

const TITLE = "Privacy policy — Travedise";
const DESCRIPTION =
  "How Travedise collects, uses and protects personal information on travedise.com and when you plan a Sri Lanka tour with us.";

/** The privacy policy, in the same shell as the rest of the site. */
---

<Base title={TITLE} description={DESCRIPTION} canonical="/privacy" ogType="website">
  <div class="v2 flex flex-col overflow-clip bg-white">
    <PlainHero title="Privacy policy" body={`Updated ${privacyUpdated}`} current="/privacy" />
    <main>
      <article class="container-v2 gutter-v2 py-[90px] max-md:py-14">
        <div class="mx-auto flex w-full max-w-[720px] flex-col">
          <p class="m-0 text-[18px]/[29px] text-[#344458] max-md:text-[16px]/[26px]">
            {privacyIntro}
          </p>
          {
            privacySections.map((section) => (
              <section>
                <h2 class="mt-12 mb-4 font-display text-[32px]/[40px] font-medium tracking-[-0.01em] text-v2-navy max-md:mt-10 max-md:text-[26px]/[34px]">
                  {section.heading}
                </h2>
                <div class="flex flex-col gap-4 text-[16px]/[26px] text-[#344458]">
                  {section.paragraphs.map((paragraph) => (
                    <p class="m-0">{paragraph}</p>
                  ))}
                  {section.list ? (
                    <ul class="m-0 flex list-disc flex-col gap-2 pl-5">
                      {section.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ) : null}
                </div>
              </section>
            ))
          }
        </div>
      </article>
    </main>
    <FooterWide statementFace="body" />
  </div>
</Base>
