---
import PageHead from "@/components/PageHead.astro";
import Base from "@/layouts/Base.astro";
import { privacyIntro, privacySections, privacyUpdated } from "@/data/privacy";
---

<Base
  title="Privacy policy"
  description="How Travedise collects, uses, shares and protects personal information from travedise.com, trip enquiries and bookings, and the choices you have."
  canonical="/privacy"
>
  <PageHead title="Privacy <em>policy.</em>" lede="What personal information we collect through this website and when you contact us, how we use it, and the choices you have.">
    <p class="small">Last updated {privacyUpdated}</p>
  </PageHead>

  <article class="article wrap" style="padding-top:0">
    <p class="lead">{privacyIntro}</p>
    {
      privacySections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.list && (
            <ul>
              {s.list.map((li) => <li><span>{li}</span></li>)}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</Base>
