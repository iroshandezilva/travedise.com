---
import Ar from "@/components/Ar.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import Frame from "@/components/Frame.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import { VEHICLE_PHOTO, vehicles, type Vehicle } from "@/data/content";
import { emLast, esc, lowerFirst } from "@/data/services-pages";

export function getStaticPaths() {
  return vehicles.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

interface Props { v: Vehicle }
const { v } = Astro.props;

const book = `/plan-your-trip?tour=${encodeURIComponent(v.name)}`;
const lower = esc(lowerFirst(v.name));
const others = vehicles.filter((o) => o.slug !== v.slug);
---

<Base title={v.name} description={v.summary} canonical={`/vehicles/${v.slug}`} section="services">
  <PageHead title={emLast(`${v.name}.`)} lede={v.summary}>
    <div class="acts">
      <a class="btn ink" href={book}>Book the {lowerFirst(v.name)} <Ar /></a>
      <a class="lnk" href="/vehicles">All vehicles</a>
    </div>
  </PageHead>

  <section class="wrap" aria-label={`${v.name} at a glance`}>
    <dl class="facts" style="--fc:3">
      <div><dt>Seats</dt><dd>{v.seatsLabel}</dd></div>
      <div><dt>Luggage</dt><dd>{v.bags}</dd></div>
      <div><dt>Model</dt><dd>{v.models}</dd></div>
    </dl>
  </section>

  <section class="sect">
    <div class="wrap svc-blocks">
      <div class="split">
        <div class="a"><Frame photo={VEHICLE_PHOTO[v.slug] ?? null} empty="Photo to come" sizes="(max-width: 860px) 100vw, 50vw" /></div>
        <div class="b">
          <h2 class="h2">Good <em>for.</em></h2>
          <p class="lede">{v.short}</p>
          <ul>{v.suits.map((s) => <li>{s}</li>)}</ul>
          <div class="acts"><a class="btn ink" href={book}>Book the {lowerFirst(v.name)} <Ar /></a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sect wrap top0">
    <SecHead title={`Why the <em>${lower}.</em>`} />
    <ul class="cols3">{v.features.map((f) => <li><h3 class="h4">{f.title}</h3><p>{f.body}</p></li>)}</ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="What the hire <em>includes.</em>" />
    <ul class="every">{v.included.map((x) => <li><span>{x}</span><span class="muted" aria-hidden="true">✓</span></li>)}</ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Other <em>vehicles.</em>"><a class="lnk" href="/vehicles">All vehicles <Ar /></a></SecHead>
    <ul class="rows">
      {others.map((o) => <li><span class="k"><a href={`/vehicles/${o.slug}`}>{o.name}</a></span><span class="v">{o.short}</span><span class="w">{o.seatsLabel}</span></li>)}
    </ul>
  </section>

  <Faq title={`Questions about <em>the ${lower}.</em>`} items={v.questions.map((q) => [q.q, q.a] as [string, string])} />

  <CloseBand photo="trainBlue" title="Where <em>to?</em>" cta={`Book the ${lowerFirst(v.name)}`} href={book} />
</Base>

<style>
  .rows .k a { text-decoration: none; }
  .rows .k a:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
</style>
