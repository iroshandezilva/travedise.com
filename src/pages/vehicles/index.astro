---
import Ar from "@/components/Ar.astro";
import Band from "@/components/Band.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import Frame from "@/components/Frame.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import { VEHICLE_PHOTO, vehicles } from "@/data/content";
import { FAQ_VEHICLES, VEHICLE_SIZES, WAYS_TO_BOOK, lowerFirst } from "@/data/services-pages";

// The cars, vans and coaches share one list of what comes with them.
const included = vehicles.find((v) => v.slug === "comfort-car")?.included ?? [];
---

<Base
  title="Vehicles and drivers"
  description="Seven vehicles with licensed drivers in Sri Lanka, from a tuk-tuk to a 45-seat coach. Book one for an airport transfer, a day out or the whole trip."
  canonical="/vehicles"
  section="services"
>
  <PageHead title="Vehicles <em>and drivers.</em>" lede="Seven vehicles, from a tuk-tuk to a 45-seat coach, each with a licensed driver. Book one for a transfer, a day or the whole trip." />

  <section class="wrap" style="padding-bottom:clamp(88px,11vw,160px)" aria-label="All vehicles">
    <div class="filters" style="margin-bottom:0">
      <div class="f-row" role="group" aria-labelledby="f-size">
        <b id="f-size">How many?</b>
        {VEHICLE_SIZES.map((s, i) => <button type="button" class="chip" data-size={s.range} aria-pressed={i === 0 ? "true" : "false"}>{s.label}</button>)}
      </div>
    </div>
    <div class="fleet-full" id="fleet">
      {
        vehicles.map((v) => (
          <div class="vrow" data-min={v.seats.min} data-max={v.seats.max}>
            <Frame photo={VEHICLE_PHOTO[v.slug] ?? null} empty="Photo to come" widths={[240, 480]} sizes="(max-width: 860px) 120px, 240px" />
            <div>
              <h2 class="nm"><a href={`/vehicles/${v.slug}`}>{v.name}</a></h2>
              <p>{v.summary}</p>
            </div>
            <span class="seats">{v.seatsLabel}<small>{v.bags}</small></span>
            <a class="btn line" href={`/plan-your-trip?tour=${encodeURIComponent(v.name)}`} aria-label={`Book the ${lowerFirst(v.name)}`}>Book <Ar /></a>
          </div>
        ))
      }
    </div>
  </section>

  <Band photo="teaAerial" pos="50% 40%" title="The roads are slow, <em>the views are not.</em>" text="Distances look short on the map. We plan drives that stop in the right places, and put you on the train where the train is better." />

  <section class="sect wrap">
    <SecHead title="Ways <em>to book.</em>" />
    <ul class="rows">{WAYS_TO_BOOK.map(([k, v, w]) => <li><span class="k">{k}</span><span class="v">{v}</span><span class="w">{w}</span></li>)}</ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Every car, van and coach <em>includes.</em>">
      <p>The <a href="/vehicles/tuk-tuk">tuk-tuk</a> and the <a href="/vehicles/safari-jeep">safari jeep</a> each list their own.</p>
    </SecHead>
    <ul class="every">{included.map((x) => <li><span>{x}</span><span class="muted" aria-hidden="true">✓</span></li>)}</ul>
  </section>

  <Faq title="Vehicle <em>questions.</em>" items={FAQ_VEHICLES} />

  <CloseBand photo="trainBlue" title="Where <em>to?</em>" cta="Book a car" />
</Base>

<style>
  .vrow .nm a { text-decoration: none; }
  .vrow .nm a:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
</style>
