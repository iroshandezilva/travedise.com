---
import Ar from "@/components/Ar.astro";
import PageHead from "@/components/PageHead.astro";
import Base from "@/layouts/Base.astro";
import planPage from "@/content/pages/plan.json";
import { CONTACT, MICRO, PLAN } from "@/data/site";

const where = ["Sri Lanka", "The Maldives", "Both", "Not sure yet"];
const months = ["Not sure yet", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const now = new Date();
const thisYear = now.getFullYear();
const years = [thisYear, thisYear + 1, thisYear + 2];
const defaultYear = now.getMonth() >= 9 ? thisYear + 1 : thisYear;
const codes = planPage.countryCodes as string[];
const countries = planPage.countries as string[];
const who: [id: string, label: string, min: number, value: number][] = [
  ["adults", "Adults", 1, 2],
  ["children", "Children", 0, 0],
];
---

<Base
  title="Plan your trip"
  description="Tell us where, when and who is coming. A travel designer in Galle or Bundeena replies within a day, with a free first route and price."
  canonical="/plan-your-trip"
  section="plan"
>
  <PageHead title="Plan your <em>trip.</em>" lede="Tell us what you are considering. A travel designer reads every message and replies within a day, with questions before suggestions." />

  <section class="wrap" style="padding-bottom:clamp(88px,11vw,160px)">
    <div class="plan-l">
      <div>
        <form id="planForm" class="form" novalidate>
          <fieldset class="fs">
            <legend>Where would you like to go?</legend>
            <div class="f-row">
              {where.map((v, i) => <button type="button" class="chip" data-chip="where" data-v={v} aria-pressed={i === 0 ? "true" : "false"}>{v}</button>)}
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>When, and for how long?</legend>
            <div class="f2">
              <div class="fld">
                <label for="month">Month</label>
                <select id="month">{months.map((m) => <option>{m}</option>)}</select>
              </div>
              <div class="fld">
                <label for="year">Year</label>
                <select id="year">{years.map((y) => <option selected={y === defaultYear}>{y}</option>)}</select>
              </div>
            </div>
            <div class="f-row" role="group" aria-label="Length of the trip">
              {PLAN.durations.map((v, i) => <button type="button" class="chip" data-chip="length" data-v={v} aria-pressed={i === 2 ? "true" : "false"}>{v}</button>)}
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>Who is coming?</legend>
            <div class="f-row" style="gap:24px">
              {
                who.map(([id, label, min, value]) => (
                  <div class="fld">
                    <label for={id}>{label}</label>
                    <div class="stepper">
                      <button type="button" data-step={id} data-d="-1" aria-label={`One fewer: ${label.toLowerCase()}`}>−</button>
                      <input id={id} type="number" min={min} max="60" value={value} inputmode="numeric" />
                      <button type="button" data-step={id} data-d="1" aria-label={`One more: ${label.toLowerCase()}`}>+</button>
                    </div>
                  </div>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>What are you interested in?</legend>
            <p class="hint2">Pick as many as you like.</p>
            <div class="f-row">
              {PLAN.interests.map((v) => <button type="button" class="chip" data-chip="interests" data-multi data-v={v} aria-pressed="false">{v}</button>)}
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>Budget per person</legend>
            <p class="hint2">In US dollars, not including international flights.</p>
            <div class="f-row">
              {PLAN.budgets.map((v, i) => <button type="button" class="chip" data-chip="budget" data-v={v} aria-pressed={i === 1 ? "true" : "false"}>{v}</button>)}
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>About you</legend>
            <p class="hint2">We need your name, email and phone number to reply.</p>
            <div class="f2">
              <div class="fld">
                <label for="first">First name</label>
                <input id="first" type="text" autocomplete="given-name" required />
              </div>
              <div class="fld">
                <label for="last">Last name</label>
                <input id="last" type="text" autocomplete="family-name" required />
              </div>
            </div>
            <div class="fld">
              <label for="email">Email</label>
              <input id="email" type="email" autocomplete="email" required />
            </div>
            <div class="f2 ph">
              <div class="fld">
                <label for="code">Country code</label>
                <select id="code" autocomplete="tel-country-code">
                  <option value="">Choose</option>
                  {codes.map((c) => <option>{c}</option>)}
                </select>
              </div>
              <div class="fld">
                <label for="phone">Phone</label>
                <input id="phone" type="tel" autocomplete="tel-national" required />
              </div>
            </div>
            <div class="fld">
              <label for="country">Where you live</label>
              <select id="country" autocomplete="country-name">
                <option value="">Choose a country</option>
                {countries.map((c) => <option>{c}</option>)}
              </select>
            </div>
            <div class="fld">
              <label for="notes">Anything else?</label>
              <textarea id="notes" placeholder="Dates, places you have heard about, things to avoid."></textarea>
            </div>
            <div class="visually-hidden" aria-hidden="true">
              <label for="website">Leave this empty</label>
              <input id="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
          </fieldset>

          <div class="acts">
            <button type="submit" class="btn ink big">Send to a travel designer <Ar /></button>
            <p class="micro">{MICRO}</p>
          </div>
          <p class="small" id="planErr" role="alert" style="color:var(--ink)"></p>
          <noscript>
            <p class="small">This form needs JavaScript to send. You can also email {CONTACT.email} or call us on {CONTACT.phones[1]!.number}.</p>
          </noscript>
        </form>

        <div id="planSent" class="sent" tabindex="-1" hidden>
          <h2 class="h2">Thank you, <span id="sentName"></span>.</h2>
          <p class="lede">Your message is with a travel designer, and a copy is on its way to your inbox. We will reply within a day, with questions before suggestions.</p>
          <div class="acts">
            <a class="btn ink" href="/packages">Browse the tours <Ar /></a>
            <a class="lnk" href="/blog">Read the travel notes</a>
          </div>
        </div>
      </div>

      <aside class="side-help" aria-label="Other ways to reach us">
        <div class="box">
          <h2 class="h4">A real person is here to help.</h2>
          {CONTACT.phones.map((p) => <div class="num"><b>{p.number}</b><span>{p.label}</span></div>)}
          <div class="num"><b>{CONTACT.email}</b><span>Email</span></div>
        </div>
        <div class="box">
          <h2 class="h4">What happens next</h2>
          <ol>{PLAN.next.map((s) => <li><span>{s}</span></li>)}</ol>
        </div>
        <div class="box">
          <h2 class="h4">Offices</h2>
          {CONTACT.offices.map((o) => <p class="small"><b style="color:var(--ink)">{o.place}</b><br />{o.address}</p>)}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .ph {
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
  }
  .fld .stepper input {
    width: 3.2em;
    padding: 0;
    border: 0;
    border-radius: 0;
    text-align: center;
    font: 500 var(--fs-body) / 1 var(--sans);
    font-variant-numeric: tabular-nums;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .fld .stepper input::-webkit-inner-spin-button,
  .fld .stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>
