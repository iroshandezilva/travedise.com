---
import Ar from "@/components/Ar.astro";
import Band from "@/components/Band.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import Frame from "@/components/Frame.astro";
import PageHero from "@/components/PageHero.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import { WEDDING_PHOTO, weddingStyles } from "@/data/content";
import { FAQ_WEDDINGS, WED_ARRANGE, WED_GO, WED_PLACES, WED_WEEK } from "@/data/services-pages";
---

<Base
  title="Weddings"
  description="Beach weddings, elopements and vow renewals in Sri Lanka and the Maldives. We plan the day, the stays and how every guest gets there."
  canonical="/weddings"
  section="services"
>
  <PageHero photo="wedCeremony" title="Weddings" lede="Beach weddings, elopements and vow renewals in Sri Lanka and the Maldives. We plan the day, the stays, and how every guest gets there.">
    <a class="btn light" href="/weddings/plan">Plan a wedding <Ar /></a>
  </PageHero>

  <section class="sect wrap">
    <p class="statement" style="margin-bottom:clamp(56px,7vw,96px)">The ceremony is one afternoon. <em>The rest is a week of travel</em> for the people you love, and we plan that too.</p>
    <div class="cardgrid" style="--n:3">
      {
        weddingStyles.map((w) => (
          <a class="card" href={`/weddings/${w.slug}`}>
            <Frame photo={WEDDING_PHOTO[w.slug] ?? null} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 33vw" />
            <span class="t h3" style="font-size:var(--fs-h3)">{w.name}</span>
            <span class="d">{w.summary}</span>
            <span class="lnk" style="justify-self:start">{WED_GO[w.slug] ?? `More about ${w.name.toLowerCase()}`} <Ar /></span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Where to <em>say it.</em>"><p>A few of the places we know well. Each comes with rooms nearby for guests.</p></SecHead>
    <ul class="rows">{WED_PLACES.map(([k, v, w]) => <li><span class="k">{k}</span><span class="v">{v}</span><span class="w">{w}</span></li>)}</ul>
  </section>

  <Band photo="groupLong" pos="50% 62%" title="Everyone <em>gets there.</em>" text="Airport pick-ups, a coach between hotels and a tuk-tuk to dinner. We plan the guests’ travel as carefully as the day." />

  <section class="sect wrap">
    <SecHead title="What <em>we arrange.</em>" />
    <ul class="also">{WED_ARRANGE.map(([b, s]) => <li><b>{b}</b><span>{s}</span></li>)}</ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="A wedding <em>week.</em>"><p>An example for a beach wedding with forty guests. Yours will differ.</p></SecHead>
    <ol class="week">{WED_WEEK.map(([d, t, p]) => <li><span class="dy">{d}</span><h3 class="h4">{t}</h3><p>{p}</p></li>)}</ol>
  </section>

  <Faq title="Wedding <em>questions.</em>" items={FAQ_WEDDINGS} />

  <CloseBand photo="beachCouple" title="Somewhere <em>warm.</em>" cta="Plan a wedding" href="/weddings/plan" />
</Base>
