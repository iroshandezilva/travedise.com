---
import Ar from "@/components/Ar.astro";
import CloseBand from "@/components/CloseBand.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import { WED_NEXT, WED_TELL } from "@/data/services-pages";
import { CONTACT, MICRO } from "@/data/site";

const enquire = "/plan-your-trip?tour=Wedding";
---

<Base
  title="Plan a wedding"
  description="Tell our wedding team about the celebration you have in mind: the kind of wedding, roughly when, how many guests and where. We reply within a day."
  canonical="/weddings/plan"
  section="services"
>
  <PageHead title="Plan a <em>wedding.</em>" lede="Tell us the rough shape of the celebration and our wedding team will reply within a day. Nothing is fixed at this stage, and nothing is booked until you say so.">
    <div class="acts">
      <a class="btn ink" href={enquire}>Start your wedding enquiry <Ar /></a>
      <a class="lnk" href="/weddings">Back to weddings</a>
    </div>
  </PageHead>

  <section class="sect wrap top0">
    <SecHead title="What to <em>tell us.</em>"><p>Share what you know. We can work out the rest together, and a rough answer to any of these is enough to start.</p></SecHead>
    <ul class="also">{WED_TELL.map(([b, s]) => <li><b>{b}</b><span>{s}</span></li>)}</ul>
  </section>

  <section class="sect wrap top0">
    <SecHead title="What happens <em>next.</em>" />
    <ol class="cols3">{WED_NEXT.map(([t, d]) => <li><h3 class="h4">{t}</h3><p>{d}</p></li>)}</ol>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Talk to our <em>wedding team.</em>"><p>If you would rather talk it through first, call or write. The person who answers is the person who plans the wedding.</p></SecHead>
    <dl class="facts" style="--fc:3">
      {CONTACT.phones.map((p) => <div><dt>{p.label}</dt><dd><a href={`tel:${p.tel}`}>{p.number}</a></dd></div>)}
      <div><dt>Email</dt><dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
    </dl>
    <div class="plan-cta"><a class="btn ink big" href={enquire}>Start your wedding enquiry <Ar /></a><p class="micro">{MICRO}</p></div>
  </section>

  <CloseBand photo="beachCouple" title="Somewhere <em>warm.</em>" cta="Start your wedding enquiry" href={enquire} />
</Base>

<style>
  .facts dd a { text-decoration: none; overflow-wrap: anywhere; }
  .facts dd a:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
</style>
