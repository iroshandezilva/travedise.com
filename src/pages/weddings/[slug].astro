---
import Ar from "@/components/Ar.astro";
import CloseBand from "@/components/CloseBand.astro";
import Faq from "@/components/Faq.astro";
import Frame from "@/components/Frame.astro";
import PageHead from "@/components/PageHead.astro";
import SecHead from "@/components/SecHead.astro";
import Base from "@/layouts/Base.astro";
import { WEDDING_PHOTO, weddingStyles, type WeddingStyle } from "@/data/content";
import { WED_GO, emLast, esc, lowerFirst } from "@/data/services-pages";

export function getStaticPaths() {
  return weddingStyles.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

interface Props { w: WeddingStyle }
const { w } = Astro.props;

const go = WED_GO[w.slug] ?? "Plan a wedding";
// The facts are, in order: who comes, how long it lasts, how long it takes to plan.
const FACT_LABELS = ["Guests", "Length", "Planning"];
const others = weddingStyles.filter((o) => o.slug !== w.slug);
---

<Base title={w.name} description={w.summary} canonical={`/weddings/${w.slug}`} section="services">
  <PageHead title={emLast(`${w.name}.`)} lede={w.summary}>
    <div class="acts">
      <a class="btn ink" href="/weddings/plan">{go} <Ar /></a>
      <a class="lnk" href="/weddings">All weddings</a>
    </div>
  </PageHead>

  <div class="wrap art-hero" style="margin-top:0">
    <Frame src={w.image.src} alt={w.image.alt} pos={w.image.position} eager />
  </div>

  <section class="wrap" style="padding-top:clamp(40px,5vw,64px)" aria-label={`${w.name} at a glance`}>
    <dl class="facts" style={`--fc:${w.facts.length}`}>
      {
        w.facts.map((f, i) => (
          <div>
            <dt>{FACT_LABELS[i] ?? f.detail}</dt>
            <dd>{f.value}{f.detail.toLowerCase() !== (FACT_LABELS[i] ?? "").toLowerCase() && <small>{f.detail}</small>}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sect wrap">
    <div class="split" style="align-items:start">
      <div class="a"><h2 class="h2" set:html={emLast(w.intro.heading)} /></div>
      <div class="b">{w.intro.paragraphs.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="sect wrap top0">
    <SecHead title={emLast(w.schedule.heading)}>{w.schedule.lede && <p>{w.schedule.lede}</p>}</SecHead>
    <ol class="week" style={`--wn:${w.schedule.items.length}`}>
      {w.schedule.items.map((it) => <li><span class="dy">{it.when}</span><h3 class="h4">{it.title}</h3><p>{it.body}</p></li>)}
    </ol>
  </section>

  <section class="sect wrap top0">
    <SecHead title={emLast(w.includes.heading)}>{w.includes.body && <p>{w.includes.body}</p>}</SecHead>
    <div class="inc">{w.includes.items.map((it) => <div><h3 class="h4">{it.title}</h3><p>{it.body}</p></div>)}</div>
    <div class="plan-cta"><a class="btn ink big" href="/weddings/plan">{go} <Ar /></a></div>
  </section>

  <section class="sect wrap top0">
    <SecHead title="Other ways <em>to marry here.</em>"><a class="lnk" href="/weddings">All weddings <Ar /></a></SecHead>
    <ul class="tlist">
      {
        others.map((o) => (
          <li>
            <a href={`/weddings/${o.slug}`}>
              <Frame photo={WEDDING_PHOTO[o.slug] ?? null} widths={[200, 400]} sizes="(max-width: 860px) 120px, 200px" />
              <span><span class="t">{o.name}</span><span class="d" style="display:block">{o.short}</span></span>
              <span class="m">{o.facts[2] ? `Plan ${o.facts[2].value} ahead` : ""}</span>
              <Ar />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq title={`Questions about <em>${esc(lowerFirst(w.name))}.</em>`} items={w.questions.map((q) => [q.q, q.a] as [string, string])} />

  <CloseBand photo={WEDDING_PHOTO[w.slug] ?? "beachCouple"} title="Somewhere <em>warm.</em>" cta={go} href="/weddings/plan" />
</Base>

<style>
  @media (min-width: 901px) {
    ol.week { grid-template-columns: repeat(var(--wn, 5), minmax(0, 1fr)); }
  }
</style>
