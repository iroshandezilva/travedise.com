---
import FooterWide from "@/components/v2/footer-wide.astro";
import PillLink from "@/components/v2/buttons/pill-link.astro";
import PlainHero from "@/components/v2/plain-hero.astro";
import Base from "@/layouts/base.astro";
---

<Base title="Page not found — Travedise" noindex>
  <div class="v2 flex min-h-screen flex-col overflow-clip bg-white">
    <PlainHero title="This page is not here." body="The link may be old, or the page has moved." />
    <main class="container-v2 flex flex-col items-start gap-4 gutter-v2 py-16 max-md:py-12">
      <PillLink href="/">Back to the home page</PillLink>
      <PillLink href="/plan-your-trip" variant="outline">Plan your trip</PillLink>
    </main>
    <FooterWide statementFace="body" />
  </div>
</Base>
