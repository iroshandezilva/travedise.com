---
import Ar from "@/components/Ar.astro";
import PageHead from "@/components/PageHead.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" description="This page could not be found. Start again from the home page, the tours or the sitemap." noindex>
  <PageHead title="This page has <em>moved on.</em>" lede="The link may be old, or the page may have a new name. Start again from the home page, or go straight to the tours.">
    <div class="acts">
      <a class="btn ink" href="/">Go to the home page <Ar /></a>
      <a class="btn line" href="/packages">See the tours</a>
    </div>
  </PageHead>

  <section class="wrap" style="padding-bottom:clamp(88px,11vw,160px)">
    <ul class="cols3">
      <li><a class="h4" href="/destinations" style="text-decoration:none">Destinations</a><p>Sri Lanka and the Maldives, alone or together.</p></li>
      <li><a class="h4" href="/blog" style="text-decoration:none">Travel notes</a><p>Which coast in which month, what to book early and what to skip.</p></li>
      <li><a class="h4" href="/sitemap" style="text-decoration:none">Sitemap</a><p>Every page on the site, in one list.</p></li>
    </ul>
  </section>
</Base>
