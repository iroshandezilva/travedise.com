---
/** A section heading (h2) with an optional side note or link. `title` may contain <em>. */
interface Props { title: string; level?: 2 | 3 }
const { title, level = 2 } = Astro.props;
const H = `h${level}` as "h2" | "h3";
const hasSide = Astro.slots.has("default");
---

<div class="sec-head">
  <H class="h2" set:html={title} />
  {hasSide && <div class="side"><slot /></div>}
</div>
