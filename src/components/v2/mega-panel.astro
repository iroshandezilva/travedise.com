---
import { islandPath } from "@/data/v2/journeys";
import type { MenuPanel } from "@/data/v2/nav";
import { places } from "@/data/v2/places";

/**
 * One desktop mega-menu panel: link columns on the left, a feature card on the right.
 * `site-nav` writes it straight after its trigger, so Tab runs from the trigger into the
 * panel's links and on to the next trigger.
 *
 * It is `position: fixed` (top set by the nav's script) because every hero clips its
 * overflow, and a panel positioned inside the hero would be cut off at its bottom edge.
 * Closed, it is `inert` and `visibility: hidden`, so nothing in it can be focused or read.
 * A solid white card, so it reads the same over a video, a photo or a plain dark hero.
 */
interface Props {
  id: string;
  panel: MenuPanel;
}
const { id, panel } = Astro.props;
const { feature } = panel;
const headingId = (col: number, group: number) => `${id}-h${col}-${group}`;
---

<div
  id={id}
  data-mega-panel
  data-open="false"
  inert
  class="v2-mega pointer-events-none fixed inset-x-0 top-[var(--mega-top,100px)] z-40 gutter-v2 pt-3.5"
>
  {/* Hover area over the gap between the pill and the card, so the pointer can cross
      from the trigger to the panel without the menu closing behind it. */}
  <span aria-hidden="true" class="pointer-events-auto absolute inset-x-0 top-0 h-3.5"></span>
  <div
    class="pointer-events-auto relative container-v2 flex max-h-[calc(100dvh-var(--mega-top,100px)-38px)] gap-10 overflow-y-auto rounded-panel border border-v2-navy/8 bg-white p-[34px] shadow-[0_24px_60px_-18px_rgb(16_27_46/0.35),0_2px_6px_rgb(16_27_46/0.06)]"
  >
    <div class="grid min-w-0 flex-1 grid-cols-3 gap-8">
      {
        panel.columns.map((column, c) => (
          <div class="flex min-w-0 flex-col gap-7">
            {column.map((group, g) => (
              <div class="flex flex-col gap-2.5">
                <p
                  id={headingId(c, g)}
                  class="m-0 text-[12px]/[16px] font-semibold tracking-[0.08em] text-v2-body uppercase"
                >
                  {group.heading}
                </p>
                <ul aria-labelledby={headingId(c, g)} class="m-0 flex list-none flex-col p-0">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="inline-block rounded-sm py-[5px] text-[16px]/[1.35] text-v2-navy decoration-v2-sky decoration-2 underline-offset-[5px] hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-v2-navy"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <a
      href={feature.href}
      class="group flex w-[320px] shrink-0 flex-col overflow-hidden rounded-card bg-v2-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-v2-navy"
    >
      <span class="relative block min-h-[190px] flex-1 overflow-hidden bg-v2-navy">
        {
          feature.map ? (
            <svg
              viewBox="-10 -10 420 690"
              preserveAspectRatio="xMidYMid meet"
              aria-hidden="true"
              class="absolute inset-0 block size-full p-4"
            >
              <path d={islandPath} fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.32)" stroke-width="3" />
              {places.map((p) => (
                <circle cx={p.map.cx} cy={p.map.cy} r="9" fill="var(--color-v2-sky)" stroke="#101b2e" stroke-width="3" />
              ))}
            </svg>
          ) : feature.image ? (
            <img
              src={feature.image}
              alt={feature.alt ?? ""}
              loading="lazy"
              decoding="async"
              class="v2-card-img absolute inset-0 block size-full object-cover"
            />
          ) : null
        }
      </span>
      <span class="flex flex-col gap-1.5 p-5">
        <span class="text-[12px]/[16px] font-semibold tracking-[0.08em] text-v2-body uppercase">
          {feature.eyebrow}
        </span>
        <span class="font-display text-[22px]/[28px] font-medium text-v2-navy">{feature.title}</span>
        <span class="text-[14px]/[21px] text-v2-body">{feature.body}</span>
        <span
          class="mt-2 text-[14px]/[20px] font-semibold text-v2-navy decoration-v2-sky decoration-2 underline-offset-[5px] group-hover:underline"
        >
          {feature.action} <span aria-hidden="true">→</span>
        </span>
      </span>
    </a>
  </div>
</div>
