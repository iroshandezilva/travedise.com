---
import type { Vehicle } from "@/data/v2/services";

import VehicleSilhouette from "./vehicle-silhouette.astro";

/**
 * One vehicle class on `/vehicles`: its drawing, seats and bags, and the way to its page.
 * `data-min` / `data-max` are read by the size filter.
 */
interface Props {
  vehicle: Vehicle;
}
const { vehicle } = Astro.props;
---

<a
  href={`/vehicles/${vehicle.slug}`}
  data-vehicle-card
  data-min={vehicle.seats.min}
  data-max={vehicle.seats.max}
  class="group flex flex-col border border-v2-navy/12 bg-white transition-[box-shadow,border-color] duration-200 hover:border-v2-navy/30 hover:shadow-[0_16px_36px_rgba(16,27,46,0.10)] motion-reduce:transition-none"
>
  <div class="flex h-[210px] items-end justify-center bg-v2-cream px-10 pt-10 pb-8 max-md:h-[180px]">
    <VehicleSilhouette
      kind={vehicle.silhouette}
      ground="#f7f5ef"
      class="w-full max-w-[300px] text-v2-navy transition-transform duration-500 ease-out-quart group-hover:-translate-x-2 motion-reduce:transition-none"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3.5 px-7 pt-6 pb-7 max-md:px-5 max-md:pt-5 max-md:pb-6">
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-[13px]/[18px] text-[#6e808e]">
      <span>{vehicle.seatsLabel}</span>
      <span aria-hidden="true" class="text-v2-sand">•</span>
      <span>{vehicle.bags}</span>
    </div>
    <h3 class="m-0 text-[25px]/[32px] font-medium text-v2-navy max-md:text-[22px]/[28px]">{vehicle.name}</h3>
    <p class="m-0 text-[15px]/[24px] text-[#52687b]">{vehicle.short}</p>
    <div class="mt-auto flex items-center justify-between gap-[18px] pt-[18px]">
      <span class="text-[13px]/[19px] text-[#8192a3]">{vehicle.models}</span>
      <span
        aria-hidden="true"
        class="flex size-11 shrink-0 items-center justify-center rounded-full border border-v2-navy/25 text-[15px] text-v2-navy transition-colors duration-150 group-hover:border-v2-navy group-hover:bg-v2-navy group-hover:text-white motion-reduce:transition-none"
      >
        ↗
      </span>
    </div>
  </div>
</a>
