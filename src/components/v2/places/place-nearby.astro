---
import Section from "@/components/v2/section.astro";
import { placeBySlug, type Place } from "@/data/v2/places";

const heading =
  "m-0 font-display text-[44px]/[52px] font-medium tracking-[-0.005em] text-v2-navy max-md:text-[30px]/[38px]";

/** Three places we pair with this one. */
interface Props {
  place: Place;
}
const { place } = Astro.props;
---

<Section surface="cream" class="py-[100px] max-md:py-14">
  <div class="flex flex-col gap-10 max-md:gap-7">
    <div class="flex items-end justify-between max-md:flex-col max-md:items-start max-md:gap-3">
      <h2 class={heading}>{place.nearby.heading}</h2>
      <a
        href="/places"
        class="inline-block shrink-0 text-[16px]/[1.2] text-v2-navy underline-offset-4 hover:underline"
      >
        All places ↗
      </a>
    </div>
    <div class="grid grid-cols-3 gap-8 max-lg:grid-cols-2 max-md:grid-cols-1 max-md:gap-5">
      {
        place.nearby.slugs.map((slug) => {
          const p = placeBySlug[slug];
          return (
            <a href={`/places/${slug}`} class="group flex flex-col bg-white">
              <div class="h-[260px] w-full overflow-clip max-md:h-[220px]">
                <img
                  src={p.image.src}
                  alt={p.image.alt}
                  loading="lazy"
                  class="v2-card-img block size-full object-cover"
                  style={p.image.position ? { objectPosition: p.image.position } : undefined}
                />
              </div>
              <div class="flex flex-col gap-2.5 px-[26px] pt-6 pb-[26px] max-md:px-5 max-md:pt-5 max-md:pb-6">
                <h3 class="m-0 text-[28px]/[34px] font-medium tracking-[-0.005em] text-v2-navy transition-colors duration-300 group-hover:text-[#344458] max-md:text-[24px]/[30px]">
                  {p.name}
                </h3>
                <p class="m-0 text-[15px]/[24px] text-[#52687b]">{p.line}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Section>
