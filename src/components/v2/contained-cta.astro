---
import { cn } from "@/lib/cn";

import BadgeLink from "./buttons/badge-link.astro";
import Section from "./section.astro";

/**
 * A navy panel inset in the white page, asking whether this route is the right one.
 * Shared by the journeys index, each journey's own page, the places and the notes.
 *
 * Pass a different heading with `<Fragment slot="heading">…</Fragment>`.
 */
interface Props {
  body?: string;
  action?: string;
  class?: string;
}
const {
  body = "Tell us your dates and what you hope to see. We will shape the rest around you.",
  action = "Let’s get planning",
  class: className,
} = Astro.props;
---

<Section class={cn("py-30 max-md:py-14", className)}>
  <div
    class="flex items-center justify-between gap-20 bg-v2-navy px-16 py-[62px] max-lg:flex-col max-lg:items-start max-lg:gap-8 max-md:px-6 max-md:py-10"
  >
    <div class="flex flex-col gap-[18px]">
      <h2 class="m-0 font-display text-[40px]/[48px] font-normal tracking-[-0.01em] text-white max-md:text-[28px]/[36px]">
        <slot name="heading">Does this sound like <em class="italic">your kind</em> of journey?</slot>
      </h2>
      <p class="m-0 text-[17px]/[26px] text-v2-muted max-md:text-[15px]/[24px]">{body}</p>
    </div>
    <BadgeLink href="/plan-your-trip" class="max-md:w-full max-md:justify-between">
      {action}
    </BadgeLink>
  </div>
</Section>
