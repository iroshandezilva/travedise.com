---
import type { Note } from "@/data/blog";

import HeroScrim from "../hero-scrim.astro";
import SiteNav from "../site-nav.astro";
import Emphasis from "./emphasis.astro";

/** A note's hero: its photo, a breadcrumb back to the notes, the title and the byline. */
interface Props {
  note: Note;
}
const { note } = Astro.props;
---

<header class="relative h-[680px] w-full shrink-0 overflow-clip gutter-v2 max-lg:h-[600px] max-md:h-[560px]">
  <img
    src={note.image.src}
    alt={note.image.alt}
    class="absolute inset-0 block size-full object-cover"
    style={{ objectPosition: note.image.position }}
  />
  <HeroScrim desktop="linear-gradient(0deg, oklab(0.182 -0.013 -0.008 / 0.88) 0%, oklab(0 0 0 / 0) 66%), linear-gradient(180deg, oklab(0.2 -0.014 -0.012 / 0.52) 0%, oklab(0 0 0 / 0) 30%)" />

  <div class="relative mx-auto h-full w-full max-w-[1280px]">
    <SiteNav current="/blog" />
    <div
      class="absolute inset-x-0 bottom-[60px] flex max-w-[860px] flex-col gap-[22px] max-md:bottom-8 max-md:gap-3.5"
    >
      <nav
        aria-label="Breadcrumb"
        class="flex items-center gap-2.5 text-[15px]/[22px] text-[#c4d2db] max-md:text-[14px]/[20px]"
      >
        <a href="/blog" class="text-white hover:opacity-80">Travel notes</a>
        <span aria-hidden="true">/</span>
        <span>{note.category}</span>
      </nav>
      <h1
        class="m-0 font-display text-[72px]/[78px] font-medium tracking-[-0.015em] text-balance text-white max-lg:text-[56px]/[62px] max-md:text-[36px]/[42px] [&_em]:font-normal"
      >
        <Emphasis text={note.title} em={note.titleEm} />
      </h1>
      <p
        class="m-0 max-w-[640px] text-[20px]/[30px] text-[#e8eef1] transition-[opacity,translate] duration-[600ms] ease-out-quint motion-reduce:transition-none starting:translate-y-3 starting:opacity-0 max-md:text-[16px]/[25px]"
      >
        {note.standfirst}
      </p>
      <div
        class="flex flex-wrap items-center gap-3 text-[15px]/[22px] text-[#c4d2db] max-md:gap-2 max-md:text-[14px]/[20px]"
      >
        <span>By {note.author.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={note.date}>{note.dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>{note.minutes} min read</span>
      </div>
    </div>
  </div>
</header>
