---
import type { Note } from "@/data/blog";

import Section from "../section.astro";
import NoteCard from "./note-card.astro";

/** Three more notes on cream, under a post. */
interface Props {
  notes: Note[];
}
const { notes } = Astro.props;
---

<Section surface="cream" class="py-[100px] max-md:py-14">
  <div class="mb-10 flex items-end justify-between gap-6 max-md:mb-7">
    <h2
      class="m-0 font-display text-[44px]/[52px] font-medium tracking-[-0.005em] text-v2-navy max-md:text-[30px]/[38px]"
    >
      Keep reading.
    </h2>
    <a href="/blog" class="shrink-0 text-[16px]/[1.2] text-v2-navy hover:opacity-80 max-md:text-[15px]">
      All travel notes ↗
    </a>
  </div>
  <div class="grid grid-cols-3 gap-8 max-lg:grid-cols-2 max-md:grid-cols-1 max-md:gap-9">
    {notes.map((note) => <NoteCard note={note} />)}
  </div>
</Section>
