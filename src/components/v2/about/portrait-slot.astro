---
/**
 * The photo, or until there is one, a cream panel with a head-and-shoulders outline. On a
 * phone an empty panel would be a large blank block, so it is left out there.
 */
interface Props {
  src?: string;
  alt: string;
  class: string;
}
const { src, alt, class: className } = Astro.props;
---

{
  src ? (
    <img src={src} alt={alt} loading="lazy" class={`object-cover ${className}`} />
  ) : (
    <div aria-hidden="true" class={`flex items-center justify-center bg-[#eeeae0] ${className} max-md:hidden`}>
      <svg viewBox="0 0 24 24" class="size-[30px]" fill="none" stroke="#b0a692" stroke-width="1.4">
        <circle cx="12" cy="9" r="3.6" />
        <path d="M5 19.5c1.6-3.4 4-5.1 7-5.1s5.4 1.7 7 5.1" stroke-linecap="round" />
      </svg>
    </div>
  )
}
