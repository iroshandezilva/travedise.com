---
import { navLinks } from "@/data/v2/shared";

import LogoMark from "./logo-mark.astro";
import MobileMenu from "./mobile-menu.astro";

/**
 * The bar that floats over every v2 hero: wordmark, glass pill of links, and the trip
 * CTA. On a phone the links collapse into the hamburger and the whole bar becomes one
 * glass pill.
 *
 * It expects to sit inside a `relative` container that is the hero's inner column.
 * `current` is the href of the page's own section; that link gets the accent underline.
 */
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<div
  class="absolute inset-x-0 top-[22px] flex h-[70px] items-center justify-between max-md:top-3.5 max-md:right-4 max-md:left-4 max-md:h-15 max-md:rounded-full max-md:border max-md:border-white/22 max-md:bg-[#10253280] max-md:pr-2 max-md:pl-4 max-md:backdrop-blur-[16px]"
>
  <a href="/" aria-label="Travedise home" class="flex h-11 w-[205px] shrink-0 items-center gap-2 max-lg:w-auto">
    <LogoMark class="h-[30px] w-[43px] max-md:h-6 max-md:w-[34px]" />
    <span class="font-display text-[28px]/[34px] font-medium text-white max-md:text-[21px]/[26px]">
      Travedise
    </span>
  </a>

  <nav
    aria-label="Main"
    class="flex h-14 items-center gap-[26px] rounded-full border border-white/29 bg-[#102532a8] px-[26px] backdrop-blur-[18px] max-lg:hidden"
  >
    {
      navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={href === current ? "page" : undefined}
          class="text-[15px]/[1.2] text-white aria-[current=page]:underline aria-[current=page]:decoration-v2-sky aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[7px]"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <div class="flex w-[205px] shrink-0 items-center justify-end max-lg:w-auto">
    <a
      href="/plan-your-trip"
      class="rounded-[50px] border border-v2-sky bg-v2-sky px-[22px] py-[13px] text-[15px]/[1.2] font-medium text-[#10212b] max-md:hidden"
    >
      Plan your trip ↗
    </a>
    <MobileMenu />
  </div>
</div>
