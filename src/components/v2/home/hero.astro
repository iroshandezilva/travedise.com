---
import PillLink from "@/components/v2/buttons/pill-link.astro";
import HeroScrim from "@/components/v2/hero-scrim.astro";
import SiteNav from "@/components/v2/site-nav.astro";
import { hero } from "@/data/v2/home";
import { images } from "@/data/v2/images";

import HeroVideo from "./hero-video.astro";

/**
 * Full-bleed video hero. On desktop the glass nav floats above a headline set a third
 * of the way down; on a phone the nav collapses into a single pill with a hamburger and
 * the headline sits at the bottom of the frame above two stacked buttons.
 */
---

<header class="relative h-[720px] w-full shrink-0 overflow-clip gutter-v2 max-md:px-0">
  <HeroVideo src={images.heroVideo} poster={images.heroPoster} />
  <HeroScrim
    desktop="linear-gradient(90deg, oklab(0.2 -0.014 -0.012 / 0.64) 0%, oklab(0.2 -0.014 -0.012 / 0.22) 57%, oklab(0.2 -0.014 -0.012 / 0.1) 100%), linear-gradient(0deg, oklab(0.182 -0.013 -0.008 / 0.73) 0%, oklab(0 0 0 / 0) 52%)"
  />

  <div class="relative mx-auto h-full w-full max-w-[1280px]">
    <SiteNav />

    <div
      class="absolute top-[262px] left-0 flex w-[900px] flex-col items-start gap-7 max-lg:top-auto max-lg:bottom-24 max-lg:w-full max-md:right-5 max-md:bottom-11 max-md:left-5 max-md:w-auto max-md:gap-5"
    >
      <h1
        class="m-0 font-display text-[60px]/[66px] font-medium tracking-[-0.01em] whitespace-pre-wrap text-white transition-[opacity,translate] duration-[600ms] ease-out-quint motion-reduce:transition-none starting:translate-y-3 starting:opacity-0 max-lg:text-[52px]/[58px] max-md:text-[40px]/[45px]"
      >{hero.heading}</h1>
      <p
        class="m-0 w-[520px] text-[20px]/[29px] text-[#e9eef1] transition-[opacity,translate] delay-[80ms] duration-[600ms] ease-out-quint motion-reduce:transition-none starting:translate-y-3 starting:opacity-0 max-lg:w-full max-lg:max-w-[520px] max-md:text-[16px]/[24px] max-md:text-[#e4ebef]"
      >
        {hero.body}
      </p>
      <div
        class="flex items-center gap-7 transition-[opacity,translate] delay-[160ms] duration-[600ms] ease-out-quint motion-reduce:transition-none starting:translate-y-3 starting:opacity-0 max-md:w-full max-md:flex-col max-md:gap-2.5"
      >
        <PillLink href="/plan-your-trip" variant="sky">Plan your trip ↗</PillLink>
        <PillLink
          href="/packages"
          variant="glass"
          class="border-transparent bg-transparent px-0 font-normal max-md:border-white/40 max-md:bg-white/12 max-md:px-7"
        >
          Browse journeys ↗
        </PillLink>
      </div>
    </div>

    <a
      href="#regions"
      class="absolute top-[572px] right-0 flex items-center gap-3.5 transition-[opacity,translate] delay-[240ms] duration-[600ms] ease-out-quint motion-reduce:transition-none starting:translate-y-3 starting:opacity-0 max-lg:hidden"
    >
      <span
        class="flex size-[46px] shrink-0 items-center justify-center rounded-full border border-white/75 text-[23px]/[1.2] text-white"
      >
        <span aria-hidden="true" class="v2-scroll-cue block">↓</span>
      </span>
      <span class="text-[14px]/[1.2] whitespace-pre text-white">Scroll to discover</span>
    </a>
  </div>
</header>
