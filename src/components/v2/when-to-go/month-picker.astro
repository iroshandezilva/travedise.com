---
import { levelLabels, monthPicker, months, regions, type Level } from "@/data/v2/when-to-go";
import { cn } from "@/lib/cn";

/** Label colour per rating: sky for the best, sand for good, a quiet white for wet. */
const levelText: Record<Level, string> = {
  3: "text-v2-sky",
  2: "text-v2-sand",
  1: "text-white/45",
};
const levelDot: Record<Level, string> = {
  3: "bg-v2-sky",
  2: "bg-v2-sand",
  1: "bg-white/45",
};

/**
 * Twelve month pills over a verdict for the chosen month and how each corner of the
 * island fares in it. The verdict card replays its rise on every pick, so each month
 * comes in as a fresh card rather than the text swapping in place.
 *
 * The page is rendered with `monthPicker.initial` chosen. Every month's words and the
 * class strings for each region row are written into the JSON block below, so the script
 * only copies them into place when another month is picked.
 */
const index = monthPicker.initial;
const month = months[index];

const pillBase =
  "h-[50px] cursor-pointer rounded-full border text-[15px]/[20px] transition-[background-color,border-color,color,scale] duration-[250ms] ease-out-quad active:scale-[0.97] motion-reduce:transition-none max-md:h-11 max-md:text-[14px]";
const pillOn = cn(pillBase, "border-v2-sky bg-v2-sky text-[#10212b]");
const pillOff = cn(pillBase, "border-white/22 bg-white/4 text-white hover:border-white/45");

/** How one region row looks at a given rating. */
const row = (level: Level) => ({
  row: cn(
    "flex items-center justify-between gap-6 px-[22px] py-3.5 transition-colors duration-[250ms] motion-reduce:transition-none max-md:gap-4 max-md:px-4",
    level === 3 ? "bg-white/8" : "bg-white/3",
  ),
  label: cn("text-[14px]/[20px] max-md:text-[13px]/[18px]", levelText[level]),
  text: levelLabels[level],
  dots: [1, 2, 3].map((n) =>
    cn(
      "size-[9px] rounded-full transition-colors duration-[250ms] motion-reduce:transition-none",
      n <= level ? levelDot[level] : "bg-white/14",
    ),
  ),
});

const data = months.map((m) => ({
  name: m.name,
  title: m.title,
  body: m.body,
  regions: m.ratings.map(row),
}));
const view = data[index];
---

<section
  id="when"
  data-month-picker
  class="w-full shrink-0 bg-[#0c1526] py-[90px] gutter-v2 max-md:py-14"
  style={{
    backgroundImage:
      "radial-gradient(900px 520px at 10% 0%, rgba(71,205,255,0.16), rgba(0,0,0,0) 60%), radial-gradient(700px 480px at 90% 80%, rgba(196,175,140,0.14), rgba(0,0,0,0) 62%)",
  }}
>
  <script type="application/json" data-months set:html={JSON.stringify({ pillOn, pillOff, months: data })} />
  <div class="container-v2 flex flex-col">
    <div
      class="mb-11 flex items-end justify-between gap-20 max-lg:flex-col max-lg:items-start max-lg:gap-4 max-md:mb-8"
    >
      <h2
        class="m-0 max-w-[640px] font-display text-[44px]/[52px] font-medium tracking-[-0.005em] text-white max-md:text-[30px]/[38px]"
      >
        {monthPicker.heading}
      </h2>
      <p
        class="m-0 w-[400px] shrink-0 text-[16px]/[25px] text-[#b8c8d1] max-lg:w-full max-lg:max-w-[560px] max-md:text-[15px]/[24px]"
      >
        {monthPicker.lede}
      </p>
    </div>

    <div role="group" aria-label="Month" class="mb-12 grid grid-cols-12 gap-2 max-lg:grid-cols-6 max-md:mb-8">
      {
        months.map((m, i) => {
          const selected = i === index;
          return (
            <button
              type="button"
              aria-pressed={selected ? "true" : "false"}
              aria-label={m.name}
              data-month={i}
              class={selected ? pillOn : pillOff}
            >
              {m.name.slice(0, 3)}
            </button>
          );
        })
      }
    </div>

    <div class="flex items-stretch gap-16 max-xl:gap-10 max-lg:flex-col max-lg:gap-8">
      <div
        aria-live="polite"
        data-verdict
        class="v2-step-in flex w-[560px] shrink-0 max-xl:w-[46%] flex-col gap-[18px] bg-white/6 p-8 max-lg:w-full max-md:gap-3.5 max-md:p-6"
      >
        <div class="text-[14px]/[20px] text-v2-sky" data-verdict-kicker>{month.name} in Sri Lanka</div>
        <h3
          class="m-0 font-heading text-[28px]/[36px] font-semibold tracking-[-0.01em] text-white max-md:text-[22px]/[30px]"
          data-verdict-title
        >
          {month.title}
        </h3>
        <p class="m-0 text-[16px]/[26px] text-[#c4d2db] max-md:text-[15px]/[24px]" data-verdict-body>
          {month.body}
        </p>
        <a
          href="/packages"
          data-verdict-link
          class="mt-auto inline-flex items-center gap-2.5 self-start rounded-full border border-white/40 px-5 py-3 text-[15px] text-white hover:bg-white/8 max-md:mt-2"
        >
          Journeys for {month.name} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="flex min-w-0 flex-1 flex-col justify-center gap-1.5">
        {
          regions.map((region, i) => {
            const r = view.regions[i];
            return (
              <div class={r.row} data-region-row>
                <div class="flex min-w-0 flex-col gap-[3px]">
                  <h3 class="m-0 font-heading text-[18px]/[26px] font-semibold text-white max-md:text-[16px]/[23px]">
                    {region.name}
                  </h3>
                  <div class="text-[14px]/[20px] text-[#b8c8d1] max-md:text-[13px]/[18px]">{region.note}</div>
                </div>
                <div class="flex shrink-0 items-center gap-4 max-md:flex-col-reverse max-md:items-end max-md:gap-1.5">
                  <div class={r.label} data-region-label>
                    {r.text}
                  </div>
                  <div aria-hidden="true" class="flex gap-[5px]">
                    {r.dots.map((dot) => (
                      <span class={dot} data-region-dot />
                    ))}
                  </div>
                </div>
              </div>
            );
          })
        }
        <p class="mt-3.5 mb-0 text-[13px]/[20px] text-[#8192a3]">{monthPicker.footnote}</p>
      </div>
    </div>
  </div>
</section>

<script>
  type Row = { row: string; label: string; text: string; dots: string[] };
  type Data = {
    pillOn: string;
    pillOff: string;
    months: { name: string; title: string; body: string; regions: Row[] }[];
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-month-picker]")) {
    const data: Data = JSON.parse(root.querySelector("[data-months]")!.textContent!);
    const pills = [...root.querySelectorAll<HTMLButtonElement>("[data-month]")];
    const verdict = root.querySelector<HTMLElement>("[data-verdict]")!;
    const rows = [...root.querySelectorAll<HTMLElement>("[data-region-row]")];

    const pick = (index: number) => {
      const month = data.months[index];
      pills.forEach((pill, i) => {
        const selected = i === index;
        pill.setAttribute("aria-pressed", String(selected));
        pill.className = selected ? data.pillOn : data.pillOff;
      });

      verdict.querySelector("[data-verdict-kicker]")!.textContent = `${month.name} in Sri Lanka`;
      verdict.querySelector("[data-verdict-title]")!.textContent = month.title;
      verdict.querySelector("[data-verdict-body]")!.textContent = month.body;
      verdict.querySelector("[data-verdict-link]")!.firstChild!.textContent = `Journeys for ${month.name} `;
      // Replay the rise, as if the card were a fresh element.
      verdict.classList.remove("v2-step-in");
      void verdict.offsetWidth;
      verdict.classList.add("v2-step-in");

      rows.forEach((el, i) => {
        const r = month.regions[i];
        el.className = r.row;
        const label = el.querySelector<HTMLElement>("[data-region-label]")!;
        label.className = r.label;
        label.textContent = r.text;
        el.querySelectorAll<HTMLElement>("[data-region-dot]").forEach((dot, n) => {
          dot.className = r.dots[n];
        });
      });
    };

    pills.forEach((pill, i) => pill.addEventListener("click", () => pick(i)));
  }
</script>
