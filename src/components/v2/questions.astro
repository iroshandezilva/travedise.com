---
import Reveal from "@/components/ui/reveal.astro";
import { questions, questionsIntro, type QuestionItem } from "@/data/v2/shared";

import PillLink from "./buttons/pill-link.astro";
import QuestionList from "./question-list.astro";

/**
 * "Before the journey begins" — the same questions on the home page and on every
 * package page, so a reader gets one answer to a question, not two.
 *
 * A grid, because the call to action sits under the intro on desktop but below the
 * whole list on a phone.
 */
interface Props {
  items?: QuestionItem[];
  /** The service sections set their own intro; the journey pages keep the shared one. */
  heading?: string;
  body?: string;
  action?: string;
  href?: string;
}
const {
  items = questions,
  heading = questionsIntro.heading,
  body = questionsIntro.body,
  action = questionsIntro.action,
  href = questionsIntro.href,
} = Astro.props;
---

<section id="questions" class="w-full shrink-0 bg-v2-cream py-[78px] gutter-v2 max-md:py-14">
  <div
    class="container-v2 grid grid-cols-[410px_1fr] gap-x-20 gap-y-[25px] max-lg:grid-cols-1 max-lg:gap-y-10 max-md:gap-y-6"
  >
    <Reveal from="rise" class="col-start-1 row-start-1 flex flex-col items-start gap-[25px] max-md:gap-6">
      <h2 class="m-0 font-display text-[45px]/[52px] font-medium text-v2-navy max-md:text-[30px]/[38px]">
        {heading}
      </h2>
      <p class="m-0 text-[17px]/[26px] text-v2-navy max-md:text-[15px]/[24px] max-md:text-[#485055]">
        {body}
      </p>
    </Reveal>

    <Reveal
      from="rise"
      delay={100}
      class="col-start-2 row-span-2 row-start-1 flex min-w-0 flex-col max-lg:col-start-1 max-lg:row-span-1 max-lg:row-start-2"
    >
      <QuestionList items={items} />
    </Reveal>

    <PillLink
      href={href}
      variant="navy"
      class="col-start-1 row-start-2 h-auto self-start justify-self-start rounded-[40px] px-6 py-4 text-[16px]/[1.2] font-normal max-lg:row-start-3 max-md:h-[52px] max-md:justify-self-stretch max-md:rounded-[26px] max-md:px-0 max-md:py-0 max-md:text-[15px]"
    >
      {action}
    </PillLink>
  </div>
</section>
