---
import type { PackageV2 } from "@/data/v2/packages";

import PillLink from "../buttons/pill-link.astro";
import Section from "../section.astro";

/** The dark bar under the hero: the journey's shape in three figures, and the CTA. */
interface Props {
  facts: PackageV2["facts"];
}
const { facts } = Astro.props;
---

<Section
  surface="navy"
  class="py-10 max-md:py-8"
  innerClass="flex items-center justify-between gap-12 max-lg:flex-col max-lg:items-start max-lg:gap-8"
>
  <div class="flex gap-16 max-lg:gap-10 max-md:flex-col max-md:gap-6">
    {
      facts.map((fact) => (
        <div class="flex flex-col gap-1.5">
          <span class="font-display text-[24px]/[30px] text-white max-md:text-[21px]/[27px]">{fact.value}</span>
          <span class="text-[14px]/[20px] text-[#b8c8d1]">{fact.detail}</span>
        </div>
      ))
    }
  </div>
  <PillLink href="/plan-your-trip" variant="sky" class="shrink-0 px-[26px] font-semibold"
    >Start planning this journey ↗</PillLink
  >
</Section>
