---
/** The white page header for pages without a photo hero. `title` may contain <em>. */
interface Props { title: string; lede?: string }
const { title, lede } = Astro.props;
---

<header class="page-head wrap">
  <h1 class="h1 intro"><span class="ln"><span set:html={title} /></span></h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
