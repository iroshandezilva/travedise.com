---
import { Font } from "astro:assets";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import WebMcpData from "@/components/WebMcpData.astro";
import "@/styles/global.css";
import { SHARE_IMAGE, SITE_URL } from "@/lib/site";
import { jsonLdScript, siteJsonLd } from "@/lib/structured-data";

type ShareImage = string | { url: string; width?: number; height?: number; alt?: string };

/**
 * Every page's <html>: favicons, meta tags, the site-wide JSON-LD, the header and footer,
 * and the one script every page shares (src/scripts/site.ts).
 *
 * `canonical` is a path ("/about"); the home page passes "/". Pages left out of search pass
 * `noindex` and no canonical. Extra JSON-LD for the page goes in `jsonLd`.
 */
interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: ShareImage;
  ogType?: "website" | "article";
  /** An article's publication date, `YYYY-MM-DD`. */
  publishedTime?: string;
  noindex?: boolean;
  section?: "destinations" | "tours" | "services" | "notes" | "about" | "plan" | "";
  jsonLd?: unknown;
  /** Preload the hero photo's URL when the page opens on one. */
  heroPreload?: string;
}

const { title, description, canonical, image = SHARE_IMAGE, ogType = "website", publishedTime, noindex = false, section = "", jsonLd, heroPreload } = Astro.props;

const absolute = (path: string) => (path.startsWith("http") ? path : `${SITE_URL}${path}`);
const canonicalUrl = canonical && (canonical === "/" ? SITE_URL : absolute(canonical));
const share = typeof image === "string" ? { url: image } : image;
const fullTitle = title === "Travedise" ? title : `${title} · Travedise`;

const FAVICONS = [
  { href: "6a3375a38fce14ddb37ecc20", rel: "icon", sizes: "32x32" },
  { href: "6a3375a3e1977d34c6b33475", rel: "icon", sizes: "48x48" },
  { href: "6a3375a3576c9849d0332f6b", rel: "icon", sizes: "192x192" },
  { href: "6a3375a31e3fd9ef9da7e4ff", rel: "icon", sizes: "512x512" },
  { href: "6a3375a351ef67e160de31e4", rel: "apple-touch-icon", sizes: "180x180" },
];

const TAWK = `(function(){
  function load(){
    if (window.__tawkLoaded) return;
    window.__tawkLoaded = true;
    var Tawk_API=window.Tawk_API||{}, Tawk_LoadStart=new Date();
    window.Tawk_API=Tawk_API; window.Tawk_LoadStart=Tawk_LoadStart;
    var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
    s1.async=true; s1.src='https://embed.tawk.to/6a8bd90e5d2e283449285f96/1k0p4foar'; s1.charset='UTF-8'; s1.setAttribute('crossorigin','*');
    s0.parentNode.insertBefore(s1,s0);
  }
  if ('requestIdleCallback' in window) requestIdleCallback(load, {timeout: 5000}); else setTimeout(load, 3000);
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {
      FAVICONS.map((f) => (
        <link href={`/assets/${f.href}_69e71a6f589fe83624cd3faf_travedise-logo.png`} rel={f.rel} type={f.rel === "icon" ? "image/png" : undefined} sizes={f.sizes} />
      ))
    }
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    {heroPreload && <link rel="preload" as="image" href={heroPreload} fetchpriority="high" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      !noindex && (
        <>
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          {share && <meta property="og:image" content={absolute(share.url)} />}
          {share?.width && <meta property="og:image:width" content={String(share.width)} />}
          {share?.height && <meta property="og:image:height" content={String(share.height)} />}
          {share?.alt && <meta property="og:image:alt" content={share.alt} />}
          <meta property="og:type" content={ogType} />
          {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
          {publishedTime && <meta property="article:published_time" content={publishedTime} />}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={fullTitle} />
          <meta name="twitter:description" content={description} />
          {share && <meta name="twitter:image" content={absolute(share.url)} />}
          {share?.alt && <meta name="twitter:image:alt" content={share.alt} />}
        </>
      )
    }
    {import.meta.env.PROD && <script is:inline set:html={TAWK} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <script type="application/ld+json" is:inline set:html={jsonLdScript(siteJsonLd)} />
    {jsonLd ? <script type="application/ld+json" is:inline set:html={jsonLdScript(jsonLd)} /> : null}
    <div class="site">
      <Header section={section} />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <WebMcpData />
    <script>
      import "@/scripts/site";
      import "@/scripts/webmcp-tools";
    </script>
  </body>
</html>
