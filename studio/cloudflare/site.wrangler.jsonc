{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stacki-studio",
  // Select your own account using CLOUDFLARE_ACCOUNT_ID.
  "main": "../src/cloudflare/site.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": false },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/studio", "/studio/*", "/__studio-deployment"],
    "not_found_handling": "404-page",
  },
  "version_metadata": { "binding": "SITE_VERSION" },
  "services": [{ "binding": "STUDIO", "service": "stacki-studio-editor" }],
}
