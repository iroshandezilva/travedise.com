{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stacki-studio-editor",
  // Select your own account using CLOUDFLARE_ACCOUNT_ID.
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": false },
  "main": "../src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  "containers": [
    {
      "class_name": "PreviewContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "observability": { "enabled": false },
    },
  ],
  "durable_objects": { "bindings": [{ "name": "PREVIEW", "class_name": "PreviewContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PreviewContainer"] }],
  "r2_buckets": [{ "binding": "DRAFTS", "bucket_name": "stacki-studio-editor-drafts" }],
  "vars": {
    "SITE_DEPLOYMENT_URL": "https://example.com/__studio-deployment",
    "STUDIO_ORIGIN": "https://example.com",
    "PREVIEW_ORIGIN": "https://preview.example.com",
    "GITHUB_REPOSITORY": "iroshandezilva/travedise.com",
    // travedise: Publish commits to `cms`; .github/workflows/cms.yml opens the cms → dev PR.
    // main and dev are branch-protected, so the editor must never target them.
    "GITHUB_BRANCH": "cms",
    "GITHUB_APP_ID": "YOUR_GITHUB_APP_ID",
    "GITHUB_INSTALLATION_ID": "YOUR_GITHUB_INSTALLATION_ID",
    "GITHUB_CLIENT_ID": "YOUR_GITHUB_CLIENT_ID",
    // travedise: only people with write access to the repository may edit or publish.
    // Never use "github" here: it lets anyone with a GitHub account edit the shared draft.
    "EDITOR_ACCESS": "repository",
    "EDITOR_GITHUB_IDS": "YOUR_GITHUB_USER_ID",
  },
}
