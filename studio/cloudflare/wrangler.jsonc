{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stacki-studio-editor",
  // Select your own account using CLOUDFLARE_ACCOUNT_ID.
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": false },
  "main": "../src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  "containers": [
    {
      "class_name": "PreviewContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "observability": { "enabled": false },
    },
  ],
  "durable_objects": { "bindings": [{ "name": "PREVIEW", "class_name": "PreviewContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PreviewContainer"] }],
  "r2_buckets": [{ "binding": "DRAFTS", "bucket_name": "stacki-studio-editor-drafts" }],
  "vars": {
    // travedise: empty on purpose. Publish lands on the cms branch and reaches the site only after
    // the owner merges the cms → dev PR and releases dev → main, so a "went live" check would
    // never match the publish commit. The editor then reports Publish as done once the commit lands.
    "SITE_DEPLOYMENT_URL": "",
    "STUDIO_ORIGIN": "https://travedise.com",
    "PREVIEW_ORIGIN": "https://preview.travedise.com",
    "GITHUB_REPOSITORY": "iroshandezilva/travedise.com",
    // travedise: Publish commits to `cms`; .github/workflows/cms.yml opens the cms → dev PR.
    // main and dev are branch-protected, so the editor must never target them.
    "GITHUB_BRANCH": "cms",
    "GITHUB_APP_ID": "YOUR_GITHUB_APP_ID",
    "GITHUB_INSTALLATION_ID": "YOUR_GITHUB_INSTALLATION_ID",
    "GITHUB_CLIENT_ID": "YOUR_GITHUB_CLIENT_ID",
    // travedise: only the GitHub accounts listed in EDITOR_GITHUB_IDS may edit or publish.
    // Editors need a GitHub account to sign in but no access to the repository: Publish goes
    // through the GitHub App, so an editor can't push code or merge PRs.
    // Any value other than "github" or "repository" means "use the list". Never use "github":
    // it lets anyone with a GitHub account edit the shared draft.
    "EDITOR_ACCESS": "allowlist",
    // Numeric GitHub user IDs, comma-separated (find one with `gh api users/<username> --jq .id`).
    // 55875936 = iroshandezilva (owner). Add each editor here and redeploy the editor Worker.
    "EDITOR_GITHUB_IDS": "55875936",
  },
}
